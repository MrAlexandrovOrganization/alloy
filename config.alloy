// Grafana Alloy: collects logs of all Docker containers on the host and
// ships them to Loki. New containers are picked up automatically.
discovery.docker "host" {
	host = "unix:///var/run/docker.sock"
}

loki.relabel "docker" {
	forward_to = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project_working_dir"]
		target_label  = "compose_project"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.host.targets
	forward_to    = [loki.process.docker.receiver]
	relabel_rules = loki.relabel.docker.rules
	labels        = {job = "docker"}
}

loki.process "docker" {
	forward_to = [loki.write.loki.receiver]

	stage.decolorize { }

	stage.drop {
		older_than = "1h"
	}

	stage.match {
		selector = `{container=~".+"} |~ "^\\s*\\{"`

		stage.json {
			expressions = {
				timestamp      = "timestamp",
				observed_time  = "observed_timestamp",
				severity_text  = "severity_text",
				severity_level = "level",
				trace_id       = "trace_id",
				span_id        = "span_id",
			}
		}
	}

	stage.match {
		selector = `{container=~".+"} |~ "^\\s*[A-Za-z_][A-Za-z0-9_.-]*="`

		stage.logfmt {
			mapping = {
				logfmt_timestamp = "ts",
				logfmt_level     = "level",
				logfmt_trace_id  = "trace_id",
				logfmt_span_id   = "span_id",
			}
		}
	}

	// Prefer explicit JSON severity, then legacy JSON and logfmt levels.
	stage.template {
		source   = "normalized_level"
		template = `{{ if .severity_text }}{{ ToLower (TrimSpace .severity_text) }}{{ else if .severity_level }}{{ ToLower (TrimSpace .severity_level) }}{{ else if .logfmt_level }}{{ ToLower (TrimSpace .logfmt_level) }}{{ else }}unknown{{ end }}`
	}

	// Bound label cardinality and reconcile Python/syslog severity aliases.
	stage.template {
		source   = "normalized_level"
		template = `{{ if eq .Value "warning" }}warn{{ else if or (eq .Value "critical") (eq .Value "crit") (eq .Value "panic") (eq .Value "emerg") (eq .Value "emergency") (eq .Value "alert") }}fatal{{ else if eq .Value "err" }}error{{ else if or (eq .Value "notice") (eq .Value "information") (eq .Value "informational") }}info{{ else if or (eq .Value "trace") (eq .Value "debug") (eq .Value "info") (eq .Value "warn") (eq .Value "error") (eq .Value "fatal") }}{{ .Value }}{{ else }}unknown{{ end }}`
	}

	stage.labels {
		values = {
			level = "normalized_level",
		}
	}

	stage.structured_metadata {
		values = {
			// Use the same severity for Loki detection and stream selectors.
			detected_level = "normalized_level",
			trace_id       = "trace_id",
			span_id        = "span_id",
		}
	}
}

loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

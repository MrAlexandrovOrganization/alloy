// Grafana Alloy: collects logs of all Docker containers on the host and
// ships them to Loki. New containers are picked up automatically.
discovery.docker "host" {
	host = "unix:///var/run/docker.sock"
}

loki.relabel "docker" {
	forward_to = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project_working_dir"]
		target_label  = "compose_project"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.host.targets
	forward_to    = [loki.process.docker.receiver]
	relabel_rules = loki.relabel.docker.rules
	labels        = {job = "docker"}
}

loki.process "docker" {
	forward_to = [loki.write.loki.receiver]

	stage.decolorize { }

	stage.drop {
		older_than = "1h"
	}

	stage.match {
		selector = `{container=~".+"} |~ "^\\s*\\{"`

		stage.json {
			expressions = {
				timestamp      = "timestamp",
				observed_time  = "observed_timestamp",
				severity_text  = "severity_text",
				severity_level = "level",
				trace_id       = "trace_id",
				span_id        = "span_id",
			}
		}
	}

	stage.match {
		selector = `{container=~".+"} |~ "^\\s*[A-Za-z_][A-Za-z0-9_.-]*="`

		stage.logfmt {
			mapping = {
				logfmt_timestamp = "ts",
				logfmt_level     = "level",
				logfmt_trace_id  = "trace_id",
				logfmt_span_id   = "span_id",
			}
		}
	}

	stage.match {
		selector = `{container="loki-loki-1"} |~ "^level="`

		stage.logfmt {
			mapping = {
				loki_caller     = "caller",
				loki_message    = "msg",
				loki_status     = "status",
				loki_latency    = "latency",
				loki_query_type = "query_type",
				loki_found      = "found",
			}
		}

		stage.regex {
			source     = "loki_caller"
			expression = `^(?P<loki_caller_file>[a-z_]+\.go):[0-9]+$`
		}

		stage.regex {
			source     = "loki_message"
			expression = `^(?P<routine_index_operation>cleaning up unwanted indexes from table index_[0-9]+|uploading table index_[0-9]+|finished uploading table index_[0-9]+)$`
		}

		// Keep slow/failed queries and unexpected index operations visible.
		stage.template {
			source   = "logfmt_level"
			template = `{{ if and (eq .Value "info") (or (and (eq .loki_caller_file "metrics.go") (or (eq .loki_query_type "stats") (eq .loki_query_type "metric") (eq .loki_query_type "limited")) (eq .loki_status "200") (eq .loki_latency "fast")) (and (eq .loki_caller_file "table_manager.go") (eq .loki_message "get or create table") (eq .loki_found "true")) (and (eq .loki_caller_file "index_set.go") .routine_index_operation)) }}debug{{ else }}{{ .Value }}{{ end }}`
		}

		// Match exact caller/message pairs, never words inside query or error text.
		stage.template {
			source   = "loki_event"
			template = `{{ .loki_caller_file }}:{{ .loki_message }}`
		}

		stage.regex {
			source     = "loki_event"
			expression = `^(?P<routine_loki_event>table\.go:listed files|compactor\.go:(compacting table|finished compacting table)|index_set\.go:removing source db files from storage|util\.go:(downloaded file|downloaded and extracted file)|marker\.go:no marks file found|(engine|roundtrip)\.go:executing query|checkpoint\.go:(attempting checkpoint for|starting checkpoint|atomic checkpoint finished|checkpoint done)|recalculate_owned_streams\.go:(starting recalculate owned streams job|completed recalculate owned streams job)|table_manager\.go:(query readiness setup completed|syncing tables|uploading tables)|composite_store_entry\.go:adjusting end timerange from future to now)$`
		}

		stage.template {
			source   = "logfmt_level"
			template = `{{ if and (eq .Value "info") .routine_loki_event }}debug{{ else }}{{ .Value }}{{ end }}`
		}
	}

	stage.match {
		selector = `{container="telemt"}`

		stage.regex {
			expression = `^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})\s+(?P<text_level>TRACE|DEBUG|INFO|WARN|ERROR)\s+telemt(::[A-Za-z0-9_]+)+:\s+`
		}
	}

	stage.match {
		selector = `{container="stash-postgres-1"}`

		stage.regex {
			expression = `^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+ [A-Za-z0-9_+:/-]+ \[[0-9]+\] (?P<text_level>DEBUG[1-5]?|INFO|NOTICE|LOG|WARNING|ERROR|FATAL|PANIC):\s+(?P<postgres_message>.*)$`
		}

		stage.regex {
			source     = "postgres_message"
			expression = `^(?P<routine_checkpoint>checkpoint starting: time|checkpoint complete: wrote [0-9]+ buffers .*total=[0-9.]+ s; .*)$`
		}

		stage.template {
			source   = "text_level"
			template = `{{ if eq .Value "LOG" }}{{ if .routine_checkpoint }}debug{{ else }}info{{ end }}{{ else if or (eq .Value "DEBUG1") (eq .Value "DEBUG2") (eq .Value "DEBUG3") (eq .Value "DEBUG4") (eq .Value "DEBUG5") }}debug{{ else }}{{ .Value }}{{ end }}`
		}
	}

	stage.match {
		selector = `{container="egress-router"}`

		stage.regex {
			expression = `^[+-][0-9]{4} [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} (?P<text_level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL|PANIC) (?P<singbox_message>.*)$`
		}

		stage.regex {
			source     = "singbox_message"
			expression = `^(\[[0-9]+ [^]]+\] )?(?P<routine_connection>(outbound/[^ ]+: outbound connection to|inbound/[^ ]+: inbound connection (from|to)) [^ ]+)$`
		}

		stage.template {
			source   = "text_level"
			template = `{{ if and (eq .Value "INFO") .routine_connection }}debug{{ else }}{{ .Value }}{{ end }}`
		}
	}

	stage.match {
		selector = `{container="kafka-kafka-ui-1"}`

		stage.regex {
			expression = `^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2},[0-9]{3}\s+(?P<text_level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL)\s+\[`
		}
	}

	stage.match {
		selector = `{container="kafka"}`

		stage.regex {
			expression = `^\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2},[0-9]{3}\]\s+(?P<text_level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL)\s+`
		}

		stage.regex {
			expression = `^\[[^]]+\] INFO \[QuorumController id=[0-9]+\] (?P<routine_controller_stats>In the last [0-9]+ ms period, [0-9]+ controller events were completed, .* \(org\.apache\.kafka\.controller\.EventPerformanceMonitor\))$`
		}

		stage.template {
			source   = "text_level"
			template = `{{ if and (eq .Value "INFO") .routine_controller_stats }}debug{{ else }}{{ .Value }}{{ end }}`
		}

		stage.regex {
			expression = `^\[[^]]+\] INFO \[QuorumController id=[0-9]+\] (?P<routine_election>Periodic task (electUnclean|electPreferred) generated 0 records in [0-9]+ microseconds\. \(org\.apache\.kafka\.controller\.PeriodicTaskControlManager\))\s*$`
		}

		stage.template {
			source   = "text_level"
			template = `{{ if and (eq .Value "INFO") .routine_election }}debug{{ else }}{{ .Value }}{{ end }}`
		}
	}

	stage.match {
		selector = `{container="ollama-ollama-1"}`

		stage.regex {
			expression = `^\[GIN\] [0-9]{4}/[0-9]{2}/[0-9]{2} - [0-9]{2}:[0-9]{2}:[0-9]{2} \|\s*(?P<http_status>[1-5][0-9]{2})\s*\|[^|]+\|\s*(?P<http_client>[^ |]+)\s*\|\s*(?P<http_method>[A-Z]+)\s+"(?P<http_path>[^"]*)"\s*$`
		}
		// GIN has no severity: classify status, with successful local probes at debug.
		stage.template {
			source   = "text_level"
			template = `{{ if .http_status }}{{ if ge .http_status "500" }}error{{ else if ge .http_status "400" }}warn{{ else if and (ge .http_status "200") (lt .http_status "300") (or (eq .http_client "127.0.0.1") (eq .http_client "::1")) (or (and (eq .http_method "HEAD") (eq .http_path "/")) (and (eq .http_method "GET") (eq .http_path "/api/tags"))) }}debug{{ else }}info{{ end }}{{ else }}unknown{{ end }}`
		}
	}

	// Prefer explicit JSON severity, then legacy JSON, logfmt and scoped text formats.
	stage.template {
		source   = "normalized_level"
		template = `{{ if .severity_text }}{{ ToLower (TrimSpace .severity_text) }}{{ else if .severity_level }}{{ ToLower (TrimSpace .severity_level) }}{{ else if .logfmt_level }}{{ ToLower (TrimSpace .logfmt_level) }}{{ else if .text_level }}{{ ToLower (TrimSpace .text_level) }}{{ else }}unknown{{ end }}`
	}

	// Bound label cardinality and reconcile Python/syslog severity aliases.
	stage.template {
		source   = "normalized_level"
		template = `{{ if eq .Value "warning" }}warn{{ else if or (eq .Value "critical") (eq .Value "crit") (eq .Value "panic") (eq .Value "emerg") (eq .Value "emergency") (eq .Value "alert") }}fatal{{ else if eq .Value "err" }}error{{ else if or (eq .Value "notice") (eq .Value "information") (eq .Value "informational") }}info{{ else if or (eq .Value "trace") (eq .Value "debug") (eq .Value "info") (eq .Value "warn") (eq .Value "error") (eq .Value "fatal") }}{{ .Value }}{{ else }}unknown{{ end }}`
	}

	stage.match {
		selector = `{container="stash-stash-1"} |~ "^\\s*\\{"`

		stage.json {
			expressions = {
				stash_message = "body || msg",
			}
		}

		stage.template {
			source   = "normalized_level"
			template = `{{ if and (eq .Value "info") (eq .stash_message "embedding backfill: processing") }}debug{{ else }}{{ .Value }}{{ end }}`
		}
	}

	stage.labels {
		values = {
			level = "normalized_level",
		}
	}

	stage.structured_metadata {
		values = {
			// Use the same severity for Loki detection and stream selectors.
			detected_level = "normalized_level",
			trace_id       = "trace_id",
			span_id        = "span_id",
		}
	}
}

loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

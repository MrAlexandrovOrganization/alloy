ALLOY_HOST=hostname
ALLOY_MEMORY_LIMIT=512m
# Go runtime soft limit, separate from the container limit above.
# Small hosts use 192MiB after measuring their live heap.
ALLOY_GOMEMLIMIT=384MiB
MONITORING_DATA_DIR=/home/user/.monitoring
LOKI_PUSH_URL=http://logs.example.invalid:3100/loki/api/v1/push
PROMETHEUS_REMOTE_WRITE_URL=http://metrics.example.invalid:9090/api/v1/write
# Central URL above is vmagent's destination; Alloy always writes to local vmagent.
# Size cap, not TTL. Measure vmagent_remotewrite_bytes_sent_total for a 24h budget.
VMAGENT_MAX_DISK_USAGE=1GiB
VMAGENT_MEMORY_LIMIT=128m
# On a receiver host use Docker network aliases: http://loki:3100/loki/api/v1/push
# and http://prometheus:9090/api/v1/write.
ALLOY_PROCFS_PATH=/host/proc
ALLOY_DOCKER_DESKTOP=false
# Optional low-overhead profile, selected separately on each host.
# 60s collects four times fewer samples than 15s, with coarser short spikes.
ALLOY_SCRAPE_INTERVAL=15s
# Default preserves every normalized severity. For warnings/errors and unknown
# messages only: ALLOY_LOG_DROP_LEVEL_REGEX=trace|debug|info
ALLOY_LOG_DROP_LEVEL_REGEX=disabled
# Optional on native Linux VPN hosts only. Enables compose.network-metrics.yml.
# HOST_NETWORK_METRICS_ADDRESS=100.64.0.99:19100
# Per-container TCP/UDP connection gauges in the existing cAdvisor exporter.
ALLOY_CADVISOR_NETWORK_DISABLED=["tcp","udp"]
# Set ALLOY_CADVISOR_NETWORK_DISABLED=[] on the VPN hosts to enable TCP/UDP.
# Optional measured collector→receiver transport workaround, scoped to readiness HTTP sockets.
# READINESS_TCP_MSS=1000

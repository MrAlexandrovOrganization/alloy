ALLOY_HOST=hostname
ALLOY_MEMORY_LIMIT=512m
MONITORING_DATA_DIR=/home/maxim/.monitoring
LOKI_PUSH_URL=http://100.64.0.3:3100/loki/api/v1/push
PROMETHEUS_REMOTE_WRITE_URL=http://100.64.0.3:9090/api/v1/write
# Central URL above is vmagent's destination; Alloy always writes to local vmagent.
# Size cap, not TTL. Measure vmagent_remotewrite_bytes_sent_total for a 24h budget.
VMAGENT_MAX_DISK_USAGE=1GiB
VMAGENT_MEMORY_LIMIT=128m
# On WSL use Docker network aliases: http://loki:3100/loki/api/v1/push
# and http://prometheus:9090/api/v1/write.
ALLOY_PROCFS_PATH=/host/proc
ALLOY_DOCKER_DESKTOP=false
